# =============================================================================
# Qonsensus — Environment Configuration
# Copy this file to .env and fill in your values before starting the stack.
# =============================================================================

# --- Docker Compose Profiles -------------------------------------------------
# Controls which services are started.
#   backend_only      → database + backend + coturn (minimum required)
#   full              → everything above + the web frontend
COMPOSE_PROFILES=full

# --- Domain & URLs -----------------------------------------------------------
# The public domain name or IP address of this server.
# All users must be able to reach this address from their browser.
BACKEND_ANNOUNCED_HOST=api.your-server-domain.com
FRONTEND_ANNOUNCED_HOST=your-server-domain.com

# Protocol used to reach the backend and frontend.
# Use "https" if you have a valid SSL certificate (strongly recommended).
# Use "http" only for testing on a local network.
BACKEND_ANNOUNCED_SCHEMA=https
FRONTEND_ANNOUNCED_SCHEMA=https

# The public domain or IP for the TURN/STUN server (coturn).
# In most setups this is the same as BACKEND_ANNOUNCED_HOST.
COTURN_DOMAIN=your-server-domain.com

# --- Ports -------------------------------------------------------------------
# Port the backend API listens on. Users connect to this from their browser.
BACKEND_PORT=3000

# Port the web frontend listens on.
# Only used when COMPOSE_PROFILES includes "full".
WEBAPP_PORT=8080

# UDP port range the backend (MediaSoup) uses for WebRTC audio/video streams.
# !! These ports must be open in your server firewall / cloud security group !!
MEDIASOUP_UDP_MIN=40000
MEDIASOUP_UDP_MAX=40100

# UDP port range coturn uses to relay media for clients behind strict firewalls.
# !! These ports must also be open in your server firewall / cloud security group !!
TURN_MIN_PORT=49152
TURN_MAX_PORT=49252

# --- Security ----------------------------------------------------------------
# A long random secret shared between the backend and coturn.
# Generate a secure value with:  openssl rand -hex 32
TURN_SECRET=replace-with-a-random-secret

# --- Database (PostgreSQL) ---------------------------------------------------
POSTGRES_USER=qonsensus
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=qonsensus
# Only change this if port 5432 is already occupied on this machine.
POSTGRES_PORT=5432
